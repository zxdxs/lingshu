 "太一": {
  "id": "77-1-1",
  "文": "招摇中央太一常以冬至之日，居叶蟄之宫四十六日，明日居天留四十六日，明日居倉門四十六日，明日居陰洛四十五日，明日居天宫四十六日，明日居玄委四十六日，明日居倉果四十六日，明日居新洛四十五日，明日復居叶蟄之宫，曰冬至矣。"
 },
 "移日": {
  "id": "77-3-1",
  "文": "太一移日，天必應之以風雨。"
 },
 "三虛": {
  "id": "77-15-2",
  "文": "三虚相摶，則為暴病卒死。"
 },
 "避風": {
  "id": "77-5-2",
  "文": "謹候虚風而避之，故聖人日避虚邪之道，如避矢石然，邪弗能害，此之謂也。"
 }
