{
 "說明": {
  "來源": "篇 20〈五邪〉",
  "條數": 5,
  "重點": "邪在五藏：先敘病候，再給取法"
 },
 "邪": [
  {
   "序": 1,
   "藏": "肺",
   "病": [
    {
     "id": "20-1-1",
     "文": "邪在肺，則病皮膚痛，寒熱，上氣喘，汗出，咳動肩背。"
    }
   ],
   "取": [
    {
     "id": "20-1-2",
     "文": "取之膺中外腧，背三節五藏之傍，以手疾按之，快然乃刺之，取之缺盆中以越之。"
    }
   ]
  },
  {
   "序": 2,
   "藏": "肝",
   "病": [
    {
     "id": "20-2-1",
     "文": "邪在肝，則兩脇中痛，寒中，惡血在內，行善掣節，時脚腫。"
    }
   ],
   "取": [
    {
     "id": "20-2-2",
     "文": "取之行間以引脇下，補三里以温胃中，取血脉以散惡血，取耳間青脉以去其掣。"
    }
   ]
  },
  {
   "序": 3,
   "藏": "脾胃",
   "病": [
    {
     "id": "20-3-1",
     "文": "邪左脾胃，則病肌肉痛。"
    },
    {
     "id": "20-3-2",
     "文": "陽氣有餘，陰氣不足，則熱中善饑；陽氣不足，陰氣有餘，則寒中腸鳴腹痛；陰陽俱有餘，若俱不足，則有寒有熱。"
    }
   ],
   "取": [
    {
     "id": "20-3-3",
     "文": "皆調于三里。"
    }
   ],
   "註": "底本此句作「邪左脾胃」，其餘四藏皆作「邪在」；照錄不改。"
  },
  {
   "序": 4,
   "藏": "腎",
   "病": [
    {
     "id": "20-4-1",
     "文": "邪在腎，則病骨痛陰痹。"
    },
    {
     "id": "20-4-2",
     "文": "陰痹者，按之而不得，腹脹腰痛，大便難，肩背頸項痛，時眩。"
    }
   ],
   "取": [
    {
     "id": "20-4-3",
     "文": "取之湧泉、崑崙，視有血者盡取之。"
    }
   ]
  },
  {
   "序": 5,
   "藏": "心",
   "病": [
    {
     "id": "20-5-1",
     "文": "邪在心，則病心痛喜悲，時眩仆。"
    }
   ],
   "取": [
    {
     "id": "20-5-2",
     "文": "視有餘不足而調之其輸也。"
    }
   ]
  }
 ]
}