 "原則": [
  {
   "id": "1-10-3",
   "文": "五藏有六府，六府有十二原，十二原出於四闗，四闗主治五藏。"
  },
  {
   "id": "1-10-4",
   "文": "五藏有疾，當取之十二原。"
  },
  {
   "id": "1-10-5",
   "文": "十二原者，五藏之所以禀三百六十五節氣味也。"
  },
  {
   "id": "1-10-14",
   "文": "凡此十二原者，主治五藏六府之有疾者也。"
  }
 ],
