 "通則": [
  {
   "n": 5,
   "組": "一、結構：先量，再談氣",
   "名": "四海：氣血有匯",
   "引": [
    {
     "id": "33-2-2",
     "卷": 5,
     "文": "經水者，皆注于海，海有東西南北，命曰四海。",
     "注": "所以應四海者也十二經水者皆注東海東海周環遂為四海十二經脈皆歸胃海水穀胃氣環流遂為氣血髓骨之海故也水穀之海比於東海也",
     "距": 48
    }
   ]
  },
  {
   "n": 8,
   "組": "二、神與氣血：一氣六名",
   "名": "六氣之脫皆有候",
   "引": [
    {
     "id": "30-13-1",
     "卷": 2,
     "文": "黃帝曰：六氣者，有餘不足，氣之多少，腦髓之虛實，血脉之清濁，何以知之？",
     "注": "六氣之中有餘不足總問也腦髓等別問取其所知也",
     "距": 0
    }
   ]
  },
  {
   "n": 11,
   "組": "二、神與氣血：一氣六名",
   "名": "人之常平",
   "引": [
    {
     "id": "47-1-4",
     "卷": 6,
     "文": "志意者，所以御精神，收魂魄，適寒温，和喜怒者也。",
     "注": "脾腎之神志意者能御精神令之守身收於魂魄使之不散調於寒暑得於中和和於喜怒不過其節者皆志意之德也",
     "距": 0
    },
    {
     "id": "47-1-9",
     "卷": 6,
     "文": "此人之常平也。",
     "注": "愚智賢不肖毋以相倚也五臟藏神六腑化谷此乃天之命分愚智雖殊得之不相依倚也津液即泣汗涎涕唾也",
     "距": 63
    }
   ]
  },
