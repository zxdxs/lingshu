 "句": [
  {
   "id": "1-5-10",
   "篇": "九鍼十二原",
   "seq": 1,
   "文": "大鍼者，尖如梃，其鋒微員，以寫機關之水也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法"
   ]
  },
  {
   "id": "1-8-6",
   "篇": "九鍼十二原",
   "seq": 1,
   "文": "所言節者，神氣之所遊行出入也，非皮肉筋骨也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "神",
    "氣血津液",
    "經脈",
    "傳承"
   ]
  },
  {
   "id": "1-10-5",
   "篇": "九鍼十二原",
   "seq": 1,
   "文": "十二原者，五藏之所以禀三百六十五節氣味也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "藏府",
    "經脈"
   ]
  },
  {
   "id": "1-10-14",
   "篇": "九鍼十二原",
   "seq": 1,
   "文": "凡此十二原者，主治五藏六府之有疾者也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "藏府"
   ]
  },
  {
   "id": "1-11-4",
   "篇": "九鍼十二原",
   "seq": 1,
   "文": "夫善用鍼者，取其疾也，猶拔刺也，猶雪汚也，猶解結也，猶決閇也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法"
   ]
  },
  {
   "id": "1-11-6",
   "篇": "九鍼十二原",
   "seq": 1,
   "文": "言不可治者，未得其術也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "傳承"
   ]
  },
  {
   "id": "1-12-2",
   "篇": "九鍼十二原",
   "seq": 1,
   "文": "陰有陽疾者，取之下陵三里，正徃無殆，氣下乃止，不下復始也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液"
   ]
  },
  {
   "id": "1-12-3",
   "篇": "九鍼十二原",
   "seq": 1,
   "文": "疾高而內者，取之陰之陵泉；疾高而外者，取之陽之陵泉也。",
   "句式": [
    "者…也"
   ],
   "桶": []
  },
  {
   "id": "2-15-5",
   "篇": "本輸",
   "seq": 2,
   "文": "腎合膀胱，膀胱者，津液之府也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "藏府"
   ]
  },
  {
   "id": "2-15-7",
   "篇": "本輸",
   "seq": 2,
   "文": "三焦者，中瀆之府也，水道出焉，屬膀胱，是孤之府也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "藏府"
   ]
  },
  {
   "id": "2-16-7",
   "篇": "本輸",
   "seq": 2,
   "文": "痿厥者，張而刺之，可令立快也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法"
   ]
  },
  {
   "id": "3-1-1",
   "篇": "小鍼解",
   "seq": 3,
   "文": "所謂易陳者，易言也。",
   "句式": [
    "所謂…者"
   ],
   "桶": [
    "傳承"
   ]
  },
  {
   "id": "3-1-2",
   "篇": "小鍼解",
   "seq": 3,
   "文": "難入者，難著于人也。",
   "句式": [
    "者…也"
   ],
   "桶": []
  },
  {
   "id": "3-1-4",
   "篇": "小鍼解",
   "seq": 3,
   "文": "上守神者，守人之血氣有餘不足，可補寫也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "神",
    "氣血津液",
    "刺法"
   ]
  },
  {
   "id": "3-1-5",
   "篇": "小鍼解",
   "seq": 3,
   "文": "神客者，正邪共會也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "神"
   ]
  },
  {
   "id": "3-1-8",
   "篇": "小鍼解",
   "seq": 3,
   "文": "在門者，邪循正氣之所出入也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液"
   ]
  },
  {
   "id": "3-1-9",
   "篇": "小鍼解",
   "seq": 3,
   "文": "未覩其疾者，先知邪正何經之疾也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "經脈"
   ]
  },
  {
   "id": "3-1-10",
   "篇": "小鍼解",
   "seq": 3,
   "文": "惡知其原者，先知何經之病所取之處也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "經脈",
    "病變"
   ]
  },
  {
   "id": "3-2-1",
   "篇": "小鍼解",
   "seq": 3,
   "文": "刺之微在數遲者，徐疾之意也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "神",
    "刺法"
   ]
  },
  {
   "id": "3-2-2",
   "篇": "小鍼解",
   "seq": 3,
   "文": "粗守關者，守四肢而不知血氣正邪之徃來也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液"
   ]
  },
  {
   "id": "3-2-4",
   "篇": "小鍼解",
   "seq": 3,
   "文": "機之動不離其空中者，知氣之虚實，用鍼之徐疾也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "刺法"
   ]
  },
  {
   "id": "3-2-5",
   "篇": "小鍼解",
   "seq": 3,
   "文": "空中之機清浄以微者，鍼以得氣，密意守氣勿失也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "神",
    "氣血津液",
    "刺法"
   ]
  },
  {
   "id": "3-2-6",
   "篇": "小鍼解",
   "seq": 3,
   "文": "其來不可逢者，氣盛不可補也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "刺法"
   ]
  },
  {
   "id": "3-2-7",
   "篇": "小鍼解",
   "seq": 3,
   "文": "其徃不可追者，氣虛不可寫也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "刺法"
   ]
  },
  {
   "id": "3-2-8",
   "篇": "小鍼解",
   "seq": 3,
   "文": "不可掛以髮者，言氣易失也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "傳承"
   ]
  },
  {
   "id": "3-2-10",
   "篇": "小鍼解",
   "seq": 3,
   "文": "知其徃來者，知氣之逆順盛虛也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液"
   ]
  },
  {
   "id": "3-2-11",
   "篇": "小鍼解",
   "seq": 3,
   "文": "要與之期者，知氣之可取之時也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "時間"
   ]
  },
  {
   "id": "3-2-12",
   "篇": "小鍼解",
   "seq": 3,
   "文": "粗之闇者，冥冥不知氣之微密也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液"
   ]
  },
  {
   "id": "3-2-13",
   "篇": "小鍼解",
   "seq": 3,
   "文": "妙哉工獨有之者，盡知鍼意也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "神",
    "刺法"
   ]
  },
  {
   "id": "3-2-14",
   "篇": "小鍼解",
   "seq": 3,
   "文": "徃者爲逆者，言氣之虛而小，小者逆也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "傳承"
   ]
  },
  {
   "id": "3-2-15",
   "篇": "小鍼解",
   "seq": 3,
   "文": "來者爲順者，言形氣之平，平者順也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "傳承"
   ]
  },
  {
   "id": "3-2-16",
   "篇": "小鍼解",
   "seq": 3,
   "文": "明知逆順，正行無間者，言知所取之處也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "傳承"
   ]
  },
  {
   "id": "3-3-1",
   "篇": "小鍼解",
   "seq": 3,
   "文": "所謂虛則實之者，氣口虛而當補之也。",
   "句式": [
    "者…也",
    "所謂…者"
   ],
   "桶": [
    "氣血津液",
    "刺法"
   ]
  },
  {
   "id": "3-3-2",
   "篇": "小鍼解",
   "seq": 3,
   "文": "滿則泄之者，氣口盛而當寫之也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "刺法"
   ]
  },
  {
   "id": "3-3-4",
   "篇": "小鍼解",
   "seq": 3,
   "文": "邪勝則虛之者，言諸經有盛者，皆寫其邪也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "經脈",
    "刺法",
    "傳承"
   ]
  },
  {
   "id": "3-3-5",
   "篇": "小鍼解",
   "seq": 3,
   "文": "徐而疾則實者，言徐內而疾出也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "傳承"
   ]
  },
  {
   "id": "3-3-6",
   "篇": "小鍼解",
   "seq": 3,
   "文": "疾而徐則虛者，言疾內而徐出也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "傳承"
   ]
  },
  {
   "id": "3-3-7",
   "篇": "小鍼解",
   "seq": 3,
   "文": "言實與虛若有若無者，言實者有氣，虛者無氣也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "傳承"
   ]
  },
  {
   "id": "3-3-8",
   "篇": "小鍼解",
   "seq": 3,
   "文": "察後與先若亾若存者，言氣之虛實，補寫之先後也，察其氣之已下與常存也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "刺法",
    "傳承"
   ]
  },
  {
   "id": "3-3-9",
   "篇": "小鍼解",
   "seq": 3,
   "文": "爲虚與實若得若失者，言補者佖然若有得也，寫則怳然若有失也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法",
    "傳承"
   ]
  },
  {
   "id": "3-4-1",
   "篇": "小鍼解",
   "seq": 3,
   "文": "夫氣之在脉也，邪氣在上者，言邪氣之中人也高，故邪氣在上也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "診法",
    "傳承"
   ]
  },
  {
   "id": "3-4-2",
   "篇": "小鍼解",
   "seq": 3,
   "文": "濁氣在中者，言水穀皆入于胃，其精氣上注於肺，濁溜于腸胃，言寒温不適，飲食不節，而病生于腸胃，故命曰濁氣在中也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "病變",
    "傳承"
   ]
  },
  {
   "id": "3-4-3",
   "篇": "小鍼解",
   "seq": 3,
   "文": "清氣在下者，言清濕地氣之中人也，必從足始，故曰清氣在下也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "傳承"
   ]
  },
  {
   "id": "3-4-5",
   "篇": "小鍼解",
   "seq": 3,
   "文": "鍼中脉則濁氣出者，取之陽明合也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "診法",
    "刺法"
   ]
  },
  {
   "id": "3-4-6",
   "篇": "小鍼解",
   "seq": 3,
   "文": "鍼大深則邪氣反沉者，言淺浮之病，不欲深刺也，深則邪氣從之入，故曰反沉也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "刺法",
    "病變",
    "傳承"
   ]
  },
  {
   "id": "3-4-7",
   "篇": "小鍼解",
   "seq": 3,
   "文": "皮肉筋脉各有所處者，言經絡各有所主也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "診法",
    "傳承"
   ]
  },
  {
   "id": "3-5-1",
   "篇": "小鍼解",
   "seq": 3,
   "文": "覩其色，察其目，知其散復，一其形，聽其動静者，言上工知相五色于目，有知調尺寸小大緩急滑濇，以言所病也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "診法",
    "病變",
    "傳承"
   ]
  },
  {
   "id": "3-5-2",
   "篇": "小鍼解",
   "seq": 3,
   "文": "知其邪正者，知論虛邪與正邪之風也。",
   "句式": [
    "者…也"
   ],
   "桶": []
  },
  {
   "id": "3-5-3",
   "篇": "小鍼解",
   "seq": 3,
   "文": "右主推之，左持而御之者，言持鍼而出入也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法",
    "傳承"
   ]
  },
  {
   "id": "3-5-4",
   "篇": "小鍼解",
   "seq": 3,
   "文": "氣至而去之者，言補寫氣調而去之也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "刺法",
    "傳承"
   ]
  },
  {
   "id": "3-5-6",
   "篇": "小鍼解",
   "seq": 3,
   "文": "節之交三百六十五會者，絡脉之滲灌諸節者也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "診法"
   ]
  },
  {
   "id": "3-6-1",
   "篇": "小鍼解",
   "seq": 3,
   "文": "所謂五藏之氣已絕于內者，脉口氣內絕不至，反取其外之病處與陽經之合，有留鍼以致陽氣，陽氣至則內重竭，重竭則死矣，其死也無氣以動，故靜。",
   "句式": [
    "所謂…者"
   ],
   "桶": [
    "氣血津液",
    "藏府",
    "經脈",
    "診法",
    "刺法",
    "病變"
   ]
  },
  {
   "id": "3-6-2",
   "篇": "小鍼解",
   "seq": 3,
   "文": "所謂五藏之氣已絕于外者，脉口氣外絕不至，反取其四末之輸，有留鍼以致其陰氣，陰氣至則陽氣反入，入則逆，逆則死矣，其死也陰氣有餘，故躁。",
   "句式": [
    "所謂…者"
   ],
   "桶": [
    "氣血津液",
    "藏府",
    "經脈",
    "診法",
    "刺法",
    "病變"
   ]
  },
  {
   "id": "3-6-3",
   "篇": "小鍼解",
   "seq": 3,
   "文": "所以察其目者，五藏使五色循明，循明則聲章，聲章者，則言聲與平生異也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "藏府",
    "診法",
    "傳承"
   ]
  },
  {
   "id": "4-4-1",
   "篇": "邪氣藏府病形",
   "seq": 4,
   "文": "岐伯曰：身半已上者，邪中之也；身半已下者，濕中之也。",
   "句式": [
    "者…也"
   ],
   "桶": []
  },
  {
   "id": "4-39-7",
   "篇": "邪氣藏府病形",
   "seq": 4,
   "文": "諸小者，陰陽形氣俱不足，勿取以鍼，而調以甘藥也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "刺法"
   ]
  },
  {
   "id": "4-52-2",
   "篇": "邪氣藏府病形",
   "seq": 4,
   "文": "胃病者，腹䐜脹，胃脘當心而痛，上肢兩脇，膈咽不通，食飲不下，取之三里也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "病變"
   ]
  },
  {
   "id": "5-2-6",
   "篇": "根結",
   "seq": 5,
   "文": "闔折則氣無所止息而痿疾起矣，故痿疾者取之陽明，視有餘不足，無所止息者，真氣稽留，邪氣居之也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "刺法"
   ]
  },
  {
   "id": "5-2-8",
   "篇": "根結",
   "seq": 5,
   "文": "骨繇者，節緩而不收也，所謂骨繇者摇故也，當窮其本也。",
   "句式": [
    "者…也",
    "所謂…者"
   ],
   "桶": [
    "經脈"
   ]
  },
  {
   "id": "5-4-7",
   "篇": "根結",
   "seq": 5,
   "文": "此所謂十二經者，盛絡皆當取之。",
   "句式": [
    "所謂…者"
   ],
   "桶": [
    "經脈"
   ]
  },
  {
   "id": "5-5-2",
   "篇": "根結",
   "seq": 5,
   "文": "所謂五十營者，五藏皆受氣。",
   "句式": [
    "所謂…者"
   ],
   "桶": [
    "氣血津液",
    "營衛",
    "藏府"
   ]
  },
  {
   "id": "5-5-5",
   "篇": "根結",
   "seq": 5,
   "文": "所謂五十動而不一代者，以爲常也，以知五藏之期。",
   "句式": [
    "所謂…者"
   ],
   "桶": [
    "藏府"
   ]
  },
  {
   "id": "5-5-6",
   "篇": "根結",
   "seq": 5,
   "文": "子之短期者，乍數乍踈也。",
   "句式": [
    "者…也"
   ],
   "桶": []
  },
  {
   "id": "5-6-1",
   "篇": "根結",
   "seq": 5,
   "文": "黃帝曰：逆順五體者，言人骨節之小大，肉之堅脆，皮之厚薄，血之清濁，氣之滑濇，脉之長短，血之多少，經絡之數，余已知之矣，此皆布衣匹夫之士也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "診法",
    "傳承"
   ]
  },
  {
   "id": "6-2-7",
   "篇": "夀夭剛柔",
   "seq": 6,
   "文": "病有形而不痛者，陽之類也；無形而痛者，陰之類也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "病變"
   ]
  },
  {
   "id": "6-11-1",
   "篇": "夀夭剛柔",
   "seq": 6,
   "文": "黃帝曰：何謂形之緩急？",
   "句式": [
    "何謂"
   ],
   "桶": []
  },
  {
   "id": "6-14-2",
   "篇": "夀夭剛柔",
   "seq": 6,
   "文": "其有因加疾者，不及二十而死也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "病變"
   ]
  },
  {
   "id": "7-3-2",
   "篇": "官鍼",
   "seq": 7,
   "文": "一曰輸刺，輸刺者，刺諸經滎輸藏腧也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "藏府",
    "經脈",
    "刺法"
   ]
  },
  {
   "id": "7-3-3",
   "篇": "官鍼",
   "seq": 7,
   "文": "二曰逺道刺，逺道刺者，病在上，取之下，刺府腧也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "藏府",
    "刺法",
    "病變"
   ]
  },
  {
   "id": "7-3-4",
   "篇": "官鍼",
   "seq": 7,
   "文": "三曰經刺，經刺者，刺大經之結絡經分也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "經脈",
    "刺法"
   ]
  },
  {
   "id": "7-3-5",
   "篇": "官鍼",
   "seq": 7,
   "文": "四曰絡刺，絡刺者，刺小絡之血脉也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "診法",
    "刺法"
   ]
  },
  {
   "id": "7-3-6",
   "篇": "官鍼",
   "seq": 7,
   "文": "五曰分刺，分刺者，刺分肉之間也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法"
   ]
  },
  {
   "id": "7-3-7",
   "篇": "官鍼",
   "seq": 7,
   "文": "六曰大寫刺，大寫刺者，刺大膿以鈹鍼也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法"
   ]
  },
  {
   "id": "7-3-8",
   "篇": "官鍼",
   "seq": 7,
   "文": "七曰毛刺，毛刺者，刺浮痹皮膚也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法"
   ]
  },
  {
   "id": "7-3-10",
   "篇": "官鍼",
   "seq": 7,
   "文": "九曰焠刺，焠刺者，刺燔鍼則取痹也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法"
   ]
  },
  {
   "id": "7-4-2",
   "篇": "官鍼",
   "seq": 7,
   "文": "一曰偶刺，偶刺者，以手直心若背，直痛所，一刺前，一刺後，以治心痹，刺此者，傍鍼之也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法",
    "病變"
   ]
  },
  {
   "id": "7-4-3",
   "篇": "官鍼",
   "seq": 7,
   "文": "二曰報刺，報刺者，刺痛無常處也，上下行者，直內無拔鍼，以左手隨病所按之，乃出鍼復刺之也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法",
    "病變"
   ]
  },
  {
   "id": "7-4-6",
   "篇": "官鍼",
   "seq": 7,
   "文": "或曰三刺，三刺者，治痹氣小深者也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "刺法"
   ]
  },
  {
   "id": "7-4-7",
   "篇": "官鍼",
   "seq": 7,
   "文": "五曰揚刺，揚刺者，正內一，傍內四，而浮之，以治寒氣之愽大者也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "刺法"
   ]
  },
  {
   "id": "7-4-8",
   "篇": "官鍼",
   "seq": 7,
   "文": "六曰直鍼刺，直鍼刺者，引皮乃刺之，以治寒氣之淺者也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "刺法"
   ]
  },
  {
   "id": "7-4-9",
   "篇": "官鍼",
   "seq": 7,
   "文": "七曰輸刺，輸刺者，直入直出，稀發鍼而深之，以治氣盛而熱者也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "刺法"
   ]
  },
  {
   "id": "7-4-10",
   "篇": "官鍼",
   "seq": 7,
   "文": "八曰短刺，短刺者，刺骨痹，稍摇而深之，致鍼骨所，以上下摩骨也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法"
   ]
  },
  {
   "id": "7-4-11",
   "篇": "官鍼",
   "seq": 7,
   "文": "九曰浮刺，浮刺者，傍入而浮之，以治肌急而寒者也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法"
   ]
  },
  {
   "id": "7-4-12",
   "篇": "官鍼",
   "seq": 7,
   "文": "十曰陰刺，陰刺者，左右率刺之，以治寒厥，中寒厥，足踝後少陰也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法"
   ]
  },
  {
   "id": "7-4-13",
   "篇": "官鍼",
   "seq": 7,
   "文": "十一曰傍鍼刺，傍鍼刺者，直刺傍刺各一，以治留痹久居者也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法"
   ]
  },
  {
   "id": "7-4-14",
   "篇": "官鍼",
   "seq": 7,
   "文": "十二曰賛刺，賛刺者，直入直出，數發鍼而淺之，出血，是謂治癰腫也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "刺法"
   ]
  },
  {
   "id": "7-5-1",
   "篇": "官鍼",
   "seq": 7,
   "文": "脉之所居深不見者，刺之微內鍼而久留之，以致其空脉氣也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "診法",
    "刺法"
   ]
  },
  {
   "id": "7-5-3",
   "篇": "官鍼",
   "seq": 7,
   "文": "所謂三刺則穀氣出者，先淺刺絕皮，以出陽邪；再刺則陰邪出者，少益深，絕皮致肌肉，未入分肉間也；已入分肉之間，則穀氣出。",
   "句式": [
    "所謂…者"
   ],
   "桶": [
    "氣血津液",
    "刺法"
   ]
  },
  {
   "id": "7-5-6",
   "篇": "官鍼",
   "seq": 7,
   "文": "故用鍼者，不知年之所加，氣之盛衰，虛實之所起，不可以爲工也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "刺法"
   ]
  },
  {
   "id": "7-6-2",
   "篇": "官鍼",
   "seq": 7,
   "文": "一曰半刺，半刺者，淺內而疾發鍼，無鍼傷肉，如拔毛狀，以取皮氣，此肺之應也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "刺法"
   ]
  },
  {
   "id": "7-6-3",
   "篇": "官鍼",
   "seq": 7,
   "文": "二曰豹文刺，豹文刺者，左右前後鍼之，中脉為故，以取經絡之血者，此心之應也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "診法",
    "刺法"
   ]
  },
  {
   "id": "7-6-5",
   "篇": "官鍼",
   "seq": 7,
   "文": "四曰合谷刺，合谷刺者，左右雞足，鍼于分肉之間，以取肌痹，此脾之應也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法"
   ]
  },
  {
   "id": "7-6-6",
   "篇": "官鍼",
   "seq": 7,
   "文": "五曰輸刺，輸刺者，直入直出，深內之至骨，以取骨痹，此腎之應也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法"
   ]
  },
  {
   "id": "8-1-6",
   "篇": "本神",
   "seq": 8,
   "文": "何謂德氣生精神魂魄心意志思智慮？",
   "句式": [
    "何謂"
   ],
   "桶": [
    "神",
    "氣血津液"
   ]
  },
  {
   "id": "8-5-3",
   "篇": "本神",
   "seq": 8,
   "文": "是故用鍼者，察觀病人之態，以知精神魂魄之存亡得失之意，五者以傷，鍼不可以治之也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "神",
    "氣血津液",
    "刺法",
    "病變"
   ]
  },
  {
   "id": "9-1-11",
   "篇": "終始",
   "seq": 9,
   "文": "所謂平人者不病，不病者，脉口人迎應四時也，上下相應而俱徃來也，六經之脉不結動也，本末之寒温之相守司也，形肉血氣必相稱也，是謂平人。",
   "句式": [
    "所謂…者"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "診法",
    "病變",
    "時間"
   ]
  },
  {
   "id": "9-1-12",
   "篇": "終始",
   "seq": 9,
   "文": "少氣者，脉口人迎俱少而不稱尺寸也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "診法"
   ]
  },
  {
   "id": "9-1-32",
   "篇": "終始",
   "seq": 9,
   "文": "所以日二取之者，太陽主胃，大富于穀氣，故可日二取之也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "時間"
   ]
  },
  {
   "id": "9-1-38",
   "篇": "終始",
   "seq": 9,
   "文": "所謂氣至而有効者，寫則益虛，虛者脉大如其故而不堅也，堅如其故者，適雖言故，病未去也。",
   "句式": [
    "者…也",
    "所謂…者"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "診法",
    "刺法",
    "病變",
    "傳承"
   ]
  },
  {
   "id": "9-1-39",
   "篇": "終始",
   "seq": 9,
   "文": "補則益實，實者脉大如其故而益堅也，夫如其故而不堅者，適雖言快，病未去也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "診法",
    "刺法",
    "病變",
    "傳承"
   ]
  },
  {
   "id": "9-1-45",
   "篇": "終始",
   "seq": 9,
   "文": "所謂穀氣至者，已補而實，已寫而虛，故以知穀氣至也。",
   "句式": [
    "者…也",
    "所謂…者"
   ],
   "桶": [
    "氣血津液",
    "刺法"
   ]
  },
  {
   "id": "9-1-46",
   "篇": "終始",
   "seq": 9,
   "文": "邪氣獨去者，陰與陽未能調，而病知愈也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "病變"
   ]
  },
  {
   "id": "9-1-66",
   "篇": "終始",
   "seq": 9,
   "文": "治病者，先刺其病所從生者也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法",
    "病變"
   ]
  },
  {
   "id": "9-1-76",
   "篇": "終始",
   "seq": 9,
   "文": "所謂二陰者，二刺陰也；一陽者，一刺陽也。",
   "句式": [
    "者…也",
    "所謂…者"
   ],
   "桶": [
    "刺法"
   ]
  },
  {
   "id": "10-17-2",
   "篇": "經脉",
   "seq": 10,
   "文": "太陰者，行氣温于皮毛者也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液"
   ]
  },
  {
   "id": "10-19-2",
   "篇": "經脉",
   "seq": 10,
   "文": "脣舌者，肌肉之本也。",
   "句式": [
    "者…也"
   ],
   "桶": []
  },
  {
   "id": "10-20-2",
   "篇": "經脉",
   "seq": 10,
   "文": "少陰者，冬脉也，伏行而濡骨髓者也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "診法"
   ]
  },
  {
   "id": "10-23-1",
   "篇": "經脉",
   "seq": 10,
   "文": "經脉十二者，伏行分肉之間，深而不見；其常見者，足太陰過于外踝之上，無所隠故也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "診法"
   ]
  },
  {
   "id": "10-23-5",
   "篇": "經脉",
   "seq": 10,
   "文": "脉之卒然動者，皆邪氣居之，留于本末；不動則熱，不堅則陷且空，不與衆同，是以知其何脉之動也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "診法",
    "刺法"
   ]
  },
  {
   "id": "10-25-1",
   "篇": "經脉",
   "seq": 10,
   "文": "黃帝曰：經脉者，常不可見也，其虛實也，以氣口知之；脉之見者，皆絡脉也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "診法"
   ]
  },
  {
   "id": "10-41-3",
   "篇": "經脉",
   "seq": 10,
   "文": "實則脊強，虛則頭重高摇之，挾脊之有過者，取之所別也。",
   "句式": [
    "者…也"
   ],
   "桶": []
  },
  {
   "id": "10-42-3",
   "篇": "經脉",
   "seq": 10,
   "文": "實則身盡痛，虛則百節盡皆縱，此脉若羅絡之血者，皆取之脾之大絡脉也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "診法",
    "病變"
   ]
  },
  {
   "id": "10-43-1",
   "篇": "經脉",
   "seq": 10,
   "文": "凡此十五絡者，實則必見，虛則必下，視之不見，求之上下，人經不同，絡脉異所別也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "診法"
   ]
  },
  {
   "id": "11-1-2",
   "篇": "經別",
   "seq": 11,
   "文": "夫十二經脉者，人之所以生，病之所以成，人之所以治，病之所以起，學之所始，工之所止也，粗之所易，上之所難也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "診法",
    "病變"
   ]
  },
  {
   "id": "12-10-1",
   "篇": "經水",
   "seq": 12,
   "文": "岐伯荅曰：其可爲度量者，取其中度也，不甚脱肉而血氣不衰也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液"
   ]
  },
  {
   "id": "13-6-7",
   "篇": "經筋",
   "seq": 13,
   "文": "此筋折紐，紐發數甚者，死不治，名曰仲秋痹也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "病變"
   ]
  },
  {
   "id": "13-7-4",
   "篇": "經筋",
   "seq": 13,
   "文": "其病轉筋者，治在燔鍼刼刺，以知為數，以痛為輸，命曰季秋痹也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法",
    "病變"
   ]
  },
  {
   "id": "14-4-36",
   "篇": "骨度",
   "seq": 14,
   "文": "是故視其經脉之在于身也，其見浮而堅，其見眀而大者，多血；細而沉者，多氣也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "診法"
   ]
  },
  {
   "id": "15-2-8",
   "篇": "五十營",
   "seq": 15,
   "文": "所謂交通者，并行一數也。",
   "句式": [
    "者…也",
    "所謂…者"
   ],
   "桶": []
  },
  {
   "id": "17-3-9",
   "篇": "脉度",
   "seq": 17,
   "文": "關格者，不得盡期而死也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "病變"
   ]
  },
  {
   "id": "18-14-1",
   "篇": "營衛生會",
   "seq": 18,
   "文": "岐伯答曰：營衛者，精氣也；血者，神氣也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "神",
    "氣血津液",
    "營衛"
   ]
  },
  {
   "id": "19-9-1",
   "篇": "四時氣",
   "seq": 19,
   "文": "覩其色，察其以知其散復者，視其目色，以知病之存亡也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "診法",
    "病變"
   ]
  },
  {
   "id": "21-1-11",
   "篇": "寒熱病",
   "seq": 21,
   "文": "三結交者，陽明、大陰也，臍下三寸關元也。",
   "句式": [
    "者…也"
   ],
   "桶": []
  },
  {
   "id": "21-1-12",
   "篇": "寒熱病",
   "seq": 21,
   "文": "厥痹者，厥氣上及腹，取陰陽之絡，視主病也，寫陽補陰經也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "刺法",
    "病變"
   ]
  },
  {
   "id": "21-1-38",
   "篇": "寒熱病",
   "seq": 21,
   "文": "刺虚者，刺其去也；刺實者，刺其來也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法"
   ]
  },
  {
   "id": "22-1-27",
   "篇": "癲狂",
   "seq": 22,
   "文": "狂，目妄見、耳妄聞、善呼者，少氣之所生也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液"
   ]
  },
  {
   "id": "22-1-37",
   "篇": "癲狂",
   "seq": 22,
   "文": "厥逆腹脹滿，腸鳴，胸滿不得息，取之下胸二脇，咳而動手者，與背腧，以手按之立快者是也。",
   "句式": [
    "者…也"
   ],
   "桶": []
  },
  {
   "id": "23-2-1",
   "篇": "熱病",
   "seq": 23,
   "文": "痱之為病也，身無痛者，四肢不收，智亂不甚，其言微知，可治；甚則不能言，不可治也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "神",
    "病變",
    "傳承"
   ]
  },
  {
   "id": "23-3-3",
   "篇": "熱病",
   "seq": 23,
   "文": "所謂勿刺者，有死徴也。",
   "句式": [
    "所謂…者"
   ],
   "桶": [
    "刺法",
    "病變"
   ]
  },
  {
   "id": "24-8-1",
   "篇": "厥病",
   "seq": 24,
   "文": "頭痛不可取于腧者，有所擊堕，惡血在于內；若肉傷，痛未已，則可刺，不可逺取也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "刺法",
    "病變"
   ]
  },
  {
   "id": "24-19-3",
   "篇": "厥病",
   "seq": 24,
   "文": "耳痛不可刺者，耳中有膿，若有乾耵聹，耳無聞也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法",
    "病變"
   ]
  },
  {
   "id": "24-22-1",
   "篇": "厥病",
   "seq": 24,
   "文": "風痹淫濼，病不可已者，足如履冰，時如入湯中，股脛淫濼，煩心頭痛，時嘔時悗，眩已汗出，久則目眩，悲以喜恐，短氣不樂，不出三年死也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "病變",
    "時間"
   ]
  },
  {
   "id": "28-20-1",
   "篇": "口問",
   "seq": 28,
   "文": "岐伯曰：心者，五藏六府之主也；目者，宗脉之所聚也，上液之道也；口鼻者，氣之門戶也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "藏府",
    "經脈",
    "診法"
   ]
  },
  {
   "id": "28-29-1",
   "篇": "口問",
   "seq": 28,
   "文": "凡此十二邪者，皆竒邪之走空竅者也。",
   "句式": [
    "者…也"
   ],
   "桶": []
  },
  {
   "id": "29-14-1",
   "篇": "師傳",
   "seq": 29,
   "文": "岐伯曰：身形支節者，藏府之蓋也，非面部之閱也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "藏府",
    "經脈"
   ]
  },
  {
   "id": "30-16-1",
   "篇": "決氣",
   "seq": 30,
   "文": "岐伯曰：六氣者，各有部主也，其貴賤善惡，可為常主，然五穀與胃為大海也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液"
   ]
  },
  {
   "id": "32-4-2",
   "篇": "平人絕穀",
   "seq": 32,
   "文": "故神者，水穀之精氣也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "神",
    "氣血津液"
   ]
  },
  {
   "id": "32-5-3",
   "篇": "平人絕穀",
   "seq": 32,
   "文": "故平人不食飲七日而死者，水穀、精氣、津液皆盡故也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "病變",
    "時間"
   ]
  },
  {
   "id": "33-4-1",
   "篇": "海論",
   "seq": 33,
   "文": "岐伯曰：人有髓海，有血海，有氣海，有水穀之海，凡此四者，以應四海也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液"
   ]
  },
  {
   "id": "34-3-1",
   "篇": "五亂",
   "seq": 34,
   "文": "黃帝曰：何謂相順？",
   "句式": [
    "何謂"
   ],
   "桶": []
  },
  {
   "id": "34-5-1",
   "篇": "五亂",
   "seq": 34,
   "文": "黃帝曰：何謂逆而亂？",
   "句式": [
    "何謂"
   ],
   "桶": []
  },
  {
   "id": "35-11-2",
   "篇": "脹論",
   "seq": 35,
   "文": "膻中者，心主之宫城也。",
   "句式": [
    "者…也"
   ],
   "桶": []
  },
  {
   "id": "35-11-5",
   "篇": "脹論",
   "seq": 35,
   "文": "胃之五竅者，閭里門戶也。",
   "句式": [
    "者…也"
   ],
   "桶": []
  },
  {
   "id": "35-11-6",
   "篇": "脹論",
   "seq": 35,
   "文": "亷泉、玊英者，津液之道也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液"
   ]
  },
  {
   "id": "37-1-2",
   "篇": "五閱五使",
   "seq": 37,
   "文": "五氣者，五藏之使也，五時之副也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "藏府",
    "時間"
   ]
  },
  {
   "id": "37-2-1",
   "篇": "五閱五使",
   "seq": 37,
   "文": "岐伯曰：五官者，五藏之閱也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "藏府"
   ]
  },
  {
   "id": "37-8-1",
   "篇": "五閱五使",
   "seq": 37,
   "文": "岐伯曰：鼻者，肺之官也；目者，肝之官也；口脣者，脾之官也；舌者，心之官也；耳者，腎之官也。",
   "句式": [
    "者…也"
   ],
   "桶": []
  },
  {
   "id": "38-1-7",
   "篇": "逆順肥瘦",
   "seq": 38,
   "文": "知用此者，固自然之物，易用之教，逆順之常也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "傳承"
   ]
  },
  {
   "id": "38-1-12",
   "篇": "逆順肥瘦",
   "seq": 38,
   "文": "岐伯曰：年質壯大，血氣充盈，膚革堅固，因加以邪，刺此者，深而留之，此肥人也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "刺法"
   ]
  },
  {
   "id": "38-1-14",
   "篇": "逆順肥瘦",
   "seq": 38,
   "文": "其為人也，貪于取與，刺此者，深而留之，多益其數也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法"
   ]
  },
  {
   "id": "38-1-18",
   "篇": "逆順肥瘦",
   "seq": 38,
   "文": "岐伯曰：視其白黒，各為調之，其端正敦厚者，其血氣和調，刺此者，無失常數也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "刺法"
   ]
  },
  {
   "id": "38-1-23",
   "篇": "逆順肥瘦",
   "seq": 38,
   "文": "岐伯曰：嬰兒者，其肉脆，血少氣弱，刺此者，以豪刺，淺刺而疾發鍼，日再可也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "刺法",
    "時間"
   ]
  },
  {
   "id": "39-4-9",
   "篇": "血絡論",
   "seq": 39,
   "文": "陰陽相得而合為痹者，此為內溢于經，外注于絡，如是者，陰陽俱有餘，雖多出血而弗能虛也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈"
   ]
  },
  {
   "id": "40-12-3",
   "篇": "陰陽清濁",
   "seq": 40,
   "文": "清濁相于者，以數調之也。",
   "句式": [
    "者…也"
   ],
   "桶": []
  },
  {
   "id": "41-6-1",
   "篇": "陰陽繫日月",
   "seq": 41,
   "文": "故足之陽者，陰中之少陽也；足之陰者，陰中之太陰也。",
   "句式": [
    "者…也"
   ],
   "桶": []
  },
  {
   "id": "41-6-2",
   "篇": "陰陽繫日月",
   "seq": 41,
   "文": "手之陽者，陽中之太陽也；手之陰者，陽中之少陰也。",
   "句式": [
    "者…也"
   ],
   "桶": []
  },
  {
   "id": "41-11-2",
   "篇": "陰陽繫日月",
   "seq": 41,
   "文": "且夫陰陽者，有名而無形，故數之可十，離之可百，散之可千，推之可萬，此之謂也。",
   "句式": [
    "者…也"
   ],
   "桶": []
  },
  {
   "id": "42-1-3",
   "篇": "病傳",
   "seq": 42,
   "文": "岐伯曰：諸方者，衆人之方也，非一人之所盡行也。",
   "句式": [
    "者…也"
   ],
   "桶": []
  },
  {
   "id": "42-1-4",
   "篇": "病傳",
   "seq": 42,
   "文": "黃帝曰：此乃所謂守一勿失，萬物畢者也。",
   "句式": [
    "所謂…者"
   ],
   "桶": []
  },
  {
   "id": "42-1-10",
   "篇": "病傳",
   "seq": 42,
   "文": "黃帝曰：何謂日醒？",
   "句式": [
    "何謂"
   ],
   "桶": [
    "時間"
   ]
  },
  {
   "id": "42-1-12",
   "篇": "病傳",
   "seq": 42,
   "文": "黃帝曰：何謂夜瞑？",
   "句式": [
    "何謂"
   ],
   "桶": [
    "時間"
   ]
  },
  {
   "id": "43-5-2",
   "篇": "淫邪發夢",
   "seq": 43,
   "文": "凡此十五不足者，至而補之，立已也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法"
   ]
  },
  {
   "id": "44-1-1",
   "篇": "順氣一日分為四時",
   "seq": 44,
   "文": "黃帝曰：夫百病之所始生者，必起于燥濕、寒暑、風雨、陰陽喜怒、飲食居處，氣合而有形，得藏而有名，余知其然也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "藏府",
    "病變"
   ]
  },
  {
   "id": "44-6-1",
   "篇": "順氣一日分為四時",
   "seq": 44,
   "文": "岐伯曰：是不應四時之氣，藏獨主其病者，是必以藏氣之所不勝時者甚，以其所勝時者起也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "藏府",
    "病變",
    "時間"
   ]
  },
  {
   "id": "44-17-1",
   "篇": "順氣一日分為四時",
   "seq": 44,
   "文": "黃帝曰：何謂藏主冬、時主夏、音主長夏、味主秋、色主春？",
   "句式": [
    "何謂"
   ],
   "桶": [
    "藏府",
    "診法",
    "時間"
   ]
  },
  {
   "id": "45-1-2",
   "篇": "外揣",
   "seq": 45,
   "文": "夫九鍼者，始於一而終于九，然未得其要道也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法"
   ]
  },
  {
   "id": "46-6-2",
   "篇": "五變",
   "seq": 46,
   "文": "人之有常病也，亦因其骨節皮膚腠理之不堅固者，邪之所舍也，故常為病也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "經脈",
    "病變"
   ]
  },
  {
   "id": "46-14-1",
   "篇": "五變",
   "seq": 46,
   "文": "少俞荅曰：夫柔弱者，必有剛强，剛强多怒，柔者易傷也。",
   "句式": [
    "者…也"
   ],
   "桶": []
  },
  {
   "id": "46-20-4",
   "篇": "五變",
   "seq": 46,
   "文": "然後臂薄者，其髓不滿，故善病寒熱也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "病變"
   ]
  },
  {
   "id": "47-1-1",
   "篇": "本藏",
   "seq": 47,
   "文": "黃帝問于岐伯曰：人之血氣精神者，所以奉生而周于性命者也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "神",
    "氣血津液"
   ]
  },
  {
   "id": "47-1-2",
   "篇": "本藏",
   "seq": 47,
   "文": "經脉者，所以行血氣而營陰陽，濡筋骨，利闗節者也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "營衛",
    "經脈",
    "診法"
   ]
  },
  {
   "id": "47-1-3",
   "篇": "本藏",
   "seq": 47,
   "文": "衛氣者，所以温分肉，充皮膚，肥腠理，司闗闔者也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "營衛"
   ]
  },
  {
   "id": "47-1-4",
   "篇": "本藏",
   "seq": 47,
   "文": "志意者，所以御精神，收魂魄，適寒温，和喜怒者也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "神",
    "氣血津液"
   ]
  },
  {
   "id": "47-1-10",
   "篇": "本藏",
   "seq": 47,
   "文": "五藏者，所以藏精神血氣魂魄者也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "神",
    "氣血津液",
    "藏府"
   ]
  },
  {
   "id": "47-1-11",
   "篇": "本藏",
   "seq": 47,
   "文": "六府者，所以化水穀而行津液者也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "藏府"
   ]
  },
  {
   "id": "47-2-2",
   "篇": "本藏",
   "seq": 47,
   "文": "五藏者，所以參天地，副陰陽，而連四時，化五節者也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "藏府",
    "經脈",
    "時間"
   ]
  },
  {
   "id": "47-13-5",
   "篇": "本藏",
   "seq": 47,
   "文": "凡此諸變者，持則安，減則病也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "病變"
   ]
  },
  {
   "id": "47-15-5",
   "篇": "本藏",
   "seq": 47,
   "文": "五藏皆端正者，和利得人心；五藏皆偏傾者，邪心而善盜，不可以為人平，反覆言語也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "藏府",
    "傳承"
   ]
  },
  {
   "id": "48-15-3",
   "篇": "禁服",
   "seq": 48,
   "文": "所謂經治者，飲藥亦曰灸刺。",
   "句式": [
    "所謂…者"
   ],
   "桶": [
    "經脈",
    "刺法"
   ]
  },
  {
   "id": "49-2-1",
   "篇": "五色",
   "seq": 49,
   "文": "黃帝曰：明堂者，鼻也；闕者，眉間也；庭者，顔也；蕃者，頰側也；蔽者，耳門也。",
   "句式": [
    "者…也"
   ],
   "桶": []
  },
  {
   "id": "49-22-13",
   "篇": "五色",
   "seq": 49,
   "文": "面王以下者，膀胱子處也。",
   "句式": [
    "者…也"
   ],
   "桶": []
  },
  {
   "id": "50-6-1",
   "篇": "論勇",
   "seq": 50,
   "文": "少俞曰：黃色薄皮弱肉者，不勝春之虚風；白色薄皮弱肉者，不勝夏之虚風；青色薄皮弱肉不勝秋之虚風；赤色薄皮弱肉不勝冬之虚風也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "診法"
   ]
  },
  {
   "id": "50-10-1",
   "篇": "論勇",
   "seq": 50,
   "文": "黃帝曰：夫人之忍痛與不忍痛者，非勇怯之分也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "病變"
   ]
  },
  {
   "id": "50-11-1",
   "篇": "論勇",
   "seq": 50,
   "文": "少俞曰：夫忍痛與不忍痛者，皮膚之薄厚，肌肉之堅脆緩急之分也，非勇怯之謂也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "病變"
   ]
  },
  {
   "id": "50-13-1",
   "篇": "論勇",
   "seq": 50,
   "文": "少俞曰：勇士者，目深以固，長衡直揚，三焦理横，其心端直，其肝大以堅，其膽滿以傍，怒則氣盛而胸張，肝舉而膽横，眥裂而目揚，毛起而面蒼，此勇士之由然者也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "藏府"
   ]
  },
  {
   "id": "50-15-1",
   "篇": "論勇",
   "seq": 50,
   "文": "少俞曰：怯士者，目大而不減，陰陽相失，其焦理縱，□□短而小，肝系緩，其膽不滿而縱，腸胃挺，脇下空，雖方大怒，氣不能滿其胸，肝肺雖舉，氣衰復下，故不能久怒，此怯士之所由然者也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液"
   ]
  },
  {
   "id": "50-17-1",
   "篇": "論勇",
   "seq": 50,
   "文": "少俞曰：酒者，水穀之精，熟穀之液也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液"
   ]
  },
  {
   "id": "51-2-5",
   "篇": "背腧",
   "seq": 51,
   "文": "以火補者，毋吹其火，須自滅也；以火寫者，疾吹其火，傳其艾，須其火滅也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法",
    "病變",
    "傳承"
   ]
  },
  {
   "id": "52-1-1",
   "篇": "衛氣",
   "seq": 52,
   "文": "黃帝曰：五藏者，所以藏精神魂魄者也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "神",
    "氣血津液",
    "藏府"
   ]
  },
  {
   "id": "52-1-2",
   "篇": "衛氣",
   "seq": 52,
   "文": "六府者，所以受水穀而行化物者也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "藏府"
   ]
  },
  {
   "id": "52-6-5",
   "篇": "衛氣",
   "seq": 52,
   "文": "痛可移者，易已也；積不痛，難已也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "病變"
   ]
  },
  {
   "id": "53-10-1",
   "篇": "論痛",
   "seq": 53,
   "文": "少俞曰：胃厚、色黒、大骨及肥者，皆勝毒；故骨瘦而薄胃者，皆不勝毒也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "診法"
   ]
  },
  {
   "id": "55-2-1",
   "篇": "逆順",
   "seq": 55,
   "文": "伯高曰：氣之逆順者，所以應天地陰陽四時五行也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "時間"
   ]
  },
  {
   "id": "55-2-2",
   "篇": "逆順",
   "seq": 55,
   "文": "脉之盛衰者，所以候血氣之虚實有餘不足刺之大約者，必明知病之可刺，與其未可刺，與其已不可刺也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "診法",
    "刺法",
    "病變"
   ]
  },
  {
   "id": "57-4-1",
   "篇": "水脹",
   "seq": 57,
   "文": "岐伯曰：膚脹者，寒氣客于皮膚之間，□□然不堅，腹大，身盡腫，皮厚，按其腹窅而不起，腹色不變，此其候也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "診法"
   ]
  },
  {
   "id": "58-3-1",
   "篇": "賊風",
   "seq": 58,
   "文": "黃帝曰：今夫子之所言者，皆病人之所自知也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "病變",
    "傳承"
   ]
  },
  {
   "id": "58-6-1",
   "篇": "賊風",
   "seq": 58,
   "文": "岐伯曰：先巫者，因知百病之勝，先知其病之所從生者，可祝而已也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "病變"
   ]
  },
  {
   "id": "59-4-2",
   "篇": "衛氣失常",
   "seq": 59,
   "文": "診視其脉大而弦急，及絕不至者，及腹皮急甚者，不可刺也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "診法",
    "刺法"
   ]
  },
  {
   "id": "59-11-5",
   "篇": "衛氣失常",
   "seq": 59,
   "文": "骨之屬者，骨空之所以受益而益腦髓者也。",
   "句式": [
    "者…也"
   ],
   "桶": []
  },
  {
   "id": "60-4-2",
   "篇": "玉版",
   "seq": 60,
   "文": "故兩軍相當，旗幟相望，白刃陳于中野者，此非一日之謀也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "時間"
   ]
  },
  {
   "id": "60-4-3",
   "篇": "玉版",
   "seq": 60,
   "文": "能使其民令行禁止，士卒無白刃之難者，非一日之教也，須㬰之得也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "時間",
    "傳承"
   ]
  },
  {
   "id": "60-6-1",
   "篇": "玉版",
   "seq": 60,
   "文": "岐伯曰：膿已成，十死一生，故聖人弗使已成，而明為良方，著之竹帛，使能者踵而傳之後世，無有終時者，為其不予遭也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "病變",
    "時間",
    "傳承"
   ]
  },
  {
   "id": "60-8-1",
   "篇": "玉版",
   "seq": 60,
   "文": "岐伯曰：以小治小者其功小，以大治大者多害，故其已成膿血者，其唯砭石鈹鋒之所取也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液"
   ]
  },
  {
   "id": "60-12-1",
   "篇": "玉版",
   "seq": 60,
   "文": "岐伯曰：以為傷者，其白眼青，黒眼小，是一逆也；內藥而嘔者，是二逆也；腹痛渴甚，是三逆也；肩項中不便，是四逆也；音嘶色脱，是五逆也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "診法",
    "病變"
   ]
  },
  {
   "id": "60-23-3",
   "篇": "玉版",
   "seq": 60,
   "文": "此所謂奪其天氣者也，非能絕其命而傾其壽者也。",
   "句式": [
    "所謂…者"
   ],
   "桶": [
    "氣血津液"
   ]
  },
  {
   "id": "61-11-1",
   "篇": "五禁",
   "seq": 61,
   "文": "黃帝曰：何謂五禁，願聞其不可刺之時。",
   "句式": [
    "何謂"
   ],
   "桶": [
    "刺法",
    "時間",
    "傳承"
   ]
  },
  {
   "id": "61-13-1",
   "篇": "五禁",
   "seq": 61,
   "文": "黃帝曰：何謂五奪？",
   "句式": [
    "何謂"
   ],
   "桶": []
  },
  {
   "id": "61-15-1",
   "篇": "五禁",
   "seq": 61,
   "文": "黃帝曰：何謂五逆？",
   "句式": [
    "何謂"
   ],
   "桶": []
  },
  {
   "id": "62-6-1",
   "篇": "動輸",
   "seq": 62,
   "文": "岐伯曰：胃氣上注于肺，其悍氣上衝頭者，循咽上走空竅，循眼系，入絡腦，出顑，下客主人，循牙車，合陽明，幷下人迎，此胃氣別走于陽明者也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈"
   ]
  },
  {
   "id": "62-10-1",
   "篇": "動輸",
   "seq": 62,
   "文": "岐伯曰：夫四末陰陽之會者，此氣之大絡也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈"
   ]
  },
  {
   "id": "62-10-2",
   "篇": "動輸",
   "seq": 62,
   "文": "四街者，氣之徑路也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液"
   ]
  },
  {
   "id": "63-10-1",
   "篇": "五味論",
   "seq": 63,
   "文": "少俞曰：甘入于胃，其氣弱小，不能上至于上焦，而與穀留于胃中者，令人柔潤者也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "刺法"
   ]
  },
  {
   "id": "64-12-1",
   "篇": "陰陽二十五人",
   "seq": 64,
   "文": "○是故五形之人二十五變者，衆之所以相欺者是也。",
   "句式": [
    "者…也"
   ],
   "桶": []
  },
  {
   "id": "67-3-1",
   "篇": "行鍼",
   "seq": 67,
   "文": "黃帝曰：何謂重陽之人？",
   "句式": [
    "何謂"
   ],
   "桶": []
  },
  {
   "id": "69-2-2",
   "篇": "憂恚無言",
   "seq": 69,
   "文": "故人之鼻洞涕出不收者，頏顙不開，分氣失也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液"
   ]
  },
  {
   "id": "71-1-5",
   "篇": "邪客",
   "seq": 71,
   "文": "衛氣者，出其悍氣之慓疾，而先行於四末分肉皮膚之間而不休者也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "營衛"
   ]
  },
  {
   "id": "71-1-14",
   "篇": "邪客",
   "seq": 71,
   "文": "此所謂決瀆壅塞，經絡大通，陰陽和得者也。",
   "句式": [
    "所謂…者"
   ],
   "桶": [
    "經脈"
   ]
  },
  {
   "id": "71-1-19",
   "篇": "邪客",
   "seq": 71,
   "文": "故其病新發者，覆杯則卧，汗出則已矣；久者，三飲而已也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "病變"
   ]
  },
  {
   "id": "72-15-2",
   "篇": "通天",
   "seq": 72,
   "文": "陽重脱者易狂，陰陽皆脱者，暴死不知人也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "病變"
   ]
  },
  {
   "id": "73-1-46",
   "篇": "官能",
   "seq": 73,
   "文": "手毒者，可使試按龜，置龜於器下而按其上，五十日而死矣；手甘者，復生如故也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "病變",
    "時間"
   ]
  },
  {
   "id": "74-3-1",
   "篇": "論疾診尺",
   "seq": 74,
   "文": "視人之目窠上微癕，如新卧起狀，其頸脉動，時咳，按其手足上，窅而不起者，風水膚脹也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "診法",
    "時間"
   ]
  },
  {
   "id": "74-4-7",
   "篇": "論疾診尺",
   "seq": 74,
   "文": "尺膚熱甚、脉盛躁者，病温也；其脉盛而滑者，病且出也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "診法",
    "病變"
   ]
  },
  {
   "id": "75-4-1",
   "篇": "刺節真邪",
   "seq": 75,
   "文": "岐伯曰：振埃者，刺外經，去陽病也；發矇者，刺府輸，去府病也；去爪者，刺闗節肢絡也；徹衣者，盡刺諸陽之竒輸也；解惑者，盡知調陰陽，補寫有餘不足，相傾移也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "藏府",
    "經脈",
    "刺法",
    "病變"
   ]
  },
  {
   "id": "75-17-1",
   "篇": "刺節真邪",
   "seq": 75,
   "文": "岐伯曰：刺此者，必於日中，刺其聽宫，中其眸子，聲聞於耳，此其輸也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法",
    "時間"
   ]
  },
  {
   "id": "75-20-2",
   "篇": "刺節真邪",
   "seq": 75,
   "文": "此所謂弗見為之，而無目視，見而取之，神明相得者也。",
   "句式": [
    "所謂…者"
   ],
   "桶": [
    "神"
   ]
  },
  {
   "id": "75-22-1",
   "篇": "刺節真邪",
   "seq": 75,
   "文": "岐伯曰：腰脊者，身之大闗節也；肢脛者，人之管以趨翔也；莖垂者，身中之機，陰精之候，津液之道也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "診法"
   ]
  },
  {
   "id": "75-45-8",
   "篇": "刺節真邪",
   "seq": 75,
   "文": "故行水者，必待天温冰釋凍解，而水可行，地可穿也。",
   "句式": [
    "者…也"
   ],
   "桶": []
  },
  {
   "id": "75-45-11",
   "篇": "刺節真邪",
   "seq": 75,
   "文": "此所謂以解結者也。",
   "句式": [
    "所謂…者"
   ],
   "桶": []
  },
  {
   "id": "75-47-2",
   "篇": "刺節真邪",
   "seq": 75,
   "文": "六經調者，謂之不病，雖病，謂之自已也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "經脈",
    "病變"
   ]
  },
  {
   "id": "75-48-1",
   "篇": "刺節真邪",
   "seq": 75,
   "文": "上寒下熱，先刺其項太陽，久留之，已刺則熨項與肩胛，令熱下合乃止，此所謂推而上之者也。",
   "句式": [
    "所謂…者"
   ],
   "桶": [
    "刺法"
   ]
  },
  {
   "id": "75-48-2",
   "篇": "刺節真邪",
   "seq": 75,
   "文": "上熱下寒，視其虚脉而陷之於經絡者取之，氣下乃止，此所謂引而下之者也。",
   "句式": [
    "所謂…者"
   ],
   "桶": [
    "氣血津液",
    "經脈",
    "診法"
   ]
  },
  {
   "id": "75-49-3",
   "篇": "刺節真邪",
   "seq": 75,
   "文": "此所謂推而散之者也。",
   "句式": [
    "所謂…者"
   ],
   "桶": []
  },
  {
   "id": "75-53-1",
   "篇": "刺節真邪",
   "seq": 75,
   "文": "𡵨伯曰：真氣者，所受於天，與穀氣幷而充身也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液"
   ]
  },
  {
   "id": "75-53-2",
   "篇": "刺節真邪",
   "seq": 75,
   "文": "正氣者，正風也，從一方來，非實風，又非虚風也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液"
   ]
  },
  {
   "id": "75-56-8",
   "篇": "刺節真邪",
   "seq": 75,
   "文": "凡此數氣者，其發無常處，而有常名也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "氣血津液"
   ]
  },
  {
   "id": "76-6-3",
   "篇": "衛氣行",
   "seq": 76,
   "文": "是故人之所以卧起之時有早晏者，竒分不盡故也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "時間"
   ]
  },
  {
   "id": "76-8-4",
   "篇": "衛氣行",
   "seq": 76,
   "文": "二十五刻者，半日之度也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "時間"
   ]
  },
  {
   "id": "76-8-7",
   "篇": "衛氣行",
   "seq": 76,
   "文": "故曰：刺實者，刺其來也；刺虚者，刺其去也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法"
   ]
  },
  {
   "id": "77-4-2",
   "篇": "九宫八風",
   "seq": 77,
   "文": "所謂有變者，太一居五宫之日，病風折樹木，揚沙石。",
   "句式": [
    "所謂…者"
   ],
   "桶": [
    "病變",
    "時間"
   ]
  },
  {
   "id": "78-15-1",
   "篇": "九鍼論",
   "seq": 78,
   "文": "岐伯曰：一曰鑱鍼者，取法於巾鍼，去末寸半，卒鋭之，長一寸六分，主熱在頭身也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "刺法"
   ]
  },
  {
   "id": "78-17-11",
   "篇": "九鍼論",
   "seq": 78,
   "文": "凡此九者，善候八正所在之處，所主左右上下身體有癰腫者，欲治之，無以其所直之日潰治之，是謂天忌日也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "診法",
    "時間"
   ]
  },
  {
   "id": "79-15-1",
   "篇": "嵗露論",
   "seq": 79,
   "文": "少師荅曰：三虚者，其死暴疾也；得三實者，邪不能傷人也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "病變"
   ]
  },
  {
   "id": "79-24-3",
   "篇": "嵗露論",
   "seq": 79,
   "文": "者矣風雨從南方來者，為虚風，賊傷人者也。",
   "句式": [
    "者…也"
   ],
   "桶": []
  },
  {
   "id": "79-26-11",
   "篇": "嵗露論",
   "seq": 79,
   "文": "此所謂候嵗之風，傷人者也。",
   "句式": [
    "所謂…者"
   ],
   "桶": [
    "診法",
    "時間"
   ]
  },
  {
   "id": "79-28-1",
   "篇": "嵗露論",
   "seq": 79,
   "文": "諸所謂風者，皆發屋、折樹木、揚沙石、起毫毛、發腠理者也。",
   "句式": [
    "者…也",
    "所謂…者"
   ],
   "桶": []
  },
  {
   "id": "81-1-34",
   "篇": "癰疽",
   "seq": 81,
   "文": "敗疵者，女子之病也。",
   "句式": [
    "者…也"
   ],
   "桶": [
    "病變"
   ]
  },
  {
   "id": "81-1-62",
   "篇": "癰疽",
   "seq": 81,
   "文": "黃帝曰：何謂疽？",
   "句式": [
    "何謂"
   ],
