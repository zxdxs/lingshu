 "九針所宜": [
  {
   "病所": "皮膚無常處",
   "用鍼": "鑱鍼"
  },
  {
   "病所": "分肉間",
   "用鍼": "員鍼"
  },
  {
   "病所": "經絡痼痹",
   "用鍼": "鋒鍼"
  },
  {
   "病所": "脉，氣少當補之",
   "用鍼": "鍉鍼"
  },
  {
   "病所": "大膿",
   "用鍼": "鈹鍼"
  },
  {
   "病所": "痹氣暴發",
   "用鍼": "員利鍼"
  },
  {
   "病所": "痹氣痛而不去",
   "用鍼": "毫鍼"
  },
  {
   "病所": "中",
   "用鍼": "長鍼"
  },
  {
   "病所": "水腫不能通關節",
   "用鍼": "大鍼"
  },
  {
   "病所": "五藏固居",
   "用鍼": "鋒鍼"
  }
 ],
 "九刺": [
  {
   "序": "一",
   "名": "輸刺",
   "法": "刺諸經滎輸藏腧也"
  },
  {
   "序": "二",
   "名": "逺道刺",
   "法": "病在上，取之下，刺府腧也"
  },
  {
   "序": "三",
   "名": "經刺",
   "法": "刺大經之結絡經分也"
  },
  {
   "序": "四",
   "名": "絡刺",
   "法": "刺小絡之血脉也"
  },
  {
   "序": "五",
   "名": "分刺",
   "法": "刺分肉之間也"
  },
  {
   "序": "六",
   "名": "大寫刺",
   "法": "刺大膿以鈹鍼也"
  },
  {
   "序": "七",
   "名": "毛刺",
   "法": "刺浮痹皮膚也"
  },
  {
   "序": "八",
   "名": "巨刺",
   "法": "左取右，右取左"
  },
  {
   "序": "九",
   "名": "焠刺",
   "法": "刺燔鍼則取痹也"
  }
 ],
 "十二節": [
  {
   "序": "一",
   "名": "偶刺",
   "法": "以手直心若背，直痛所，一刺前，一刺後，以治心痹"
  },
  {
   "序": "二",
   "名": "報刺",
   "法": "刺痛無常處也，上下行者，直內無拔鍼，以左手隨病所按之，乃出鍼復刺之"
  },
  {
   "序": "三",
   "名": "恢刺",
   "法": "恢刺直刺傍之，舉之前後，恢筋急，以治筋痹"
  },
  {
   "序": "四",
   "名": "齊刺",
   "法": "直入一，傍入二，以治寒氣小深者"
  },
  {
   "序": "五",
   "名": "揚刺",
   "法": "正內一，傍內四，而浮之，以治寒氣之愽大者"
  },
  {
   "序": "六",
   "名": "直鍼刺",
   "法": "引皮乃刺之，以治寒氣之淺者"
  },
  {
   "序": "七",
   "名": "輸刺",
   "法": "直入直出，稀發鍼而深之，以治氣盛而熱者"
  },
  {
   "序": "八",
   "名": "短刺",
   "法": "刺骨痹，稍摇而深之，致鍼骨所，以上下摩骨"
  },
  {
   "序": "九",
   "名": "浮刺",
   "法": "傍入而浮之，以治肌急而寒者"
  },
  {
   "序": "十",
   "名": "陰刺",
   "法": "左右率刺之，以治寒厥"
  },
  {
   "序": "十一",
   "名": "傍鍼刺",
   "法": "直刺傍刺各一，以治留痹久居者"
  },
  {
   "序": "十二",
   "名": "賛刺",
   "法": "直入直出，數發鍼而淺之，出血，是謂治癰腫"
  }
 ],
