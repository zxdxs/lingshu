{
 "模組": "津液五別",
 "出處": {
  "篇序": 36,
  "篇名": "五癃津液別"
 },
 "學習目標": [
  "知道五液各自何來",
  "分清津與液",
  "知道水脹的成因"
 ],
 "五別": [
  {
   "因": "天寒衣薄",
   "果": "溺與氣",
   "原文": "天寒衣薄則為溺與氣",
   "篇名": "五癃津液別"
  },
  {
   "因": "天熱衣厚",
   "果": "汗",
   "原文": "天熱衣厚則為汗",
   "篇名": "五癃津液別"
  },
  {
   "因": "悲哀氣并",
   "果": "泣",
   "原文": "悲哀氣并則為泣",
   "篇名": "五癃津液別"
  },
  {
   "因": "中熱胃緩",
   "果": "唾",
   "原文": "中熱胃緩則為唾",
   "篇名": "五癃津液別"
  },
  {
   "因": "邪氣內逆",
   "果": "水脹",
   "原文": "邪氣內逆則氣為之閉塞而不行不行則為水脹",
   "篇名": "五癃津液別"
  }
 ],
 "津液之別": [
  {
   "條": "津",
   "原文": "三焦出氣以温肌肉充皮膚為其津",
   "說明": "溫肌肉、充皮膚、可外達者為津",
   "篇名": "五癃津液別"
  },
  {
   "條": "液",
   "原文": "其流而不行者為液",
   "說明": "流注而不外行者為液",
   "篇名": "五癃津液別"
  }
 ],
 "校記": [
  "「五別」原文列溺與氣、汗、泣、唾、水脹五項，其中「溺與氣」為一項。"
 ]
}