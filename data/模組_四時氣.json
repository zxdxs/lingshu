{
 "模組": "四時氣",
 "出處": {
  "篇序": 19,
  "篇名": "四時氣"
 },
 "學習目標": [
  "記住四季所取部位",
  "知道幾種病的取法"
 ],
 "四時刺法": [
  {
   "時": "春",
   "所取": "經血脉分肉之間",
   "原文": "春取經血脉分肉之間",
   "篇名": "四時氣"
  },
  {
   "時": "夏",
   "所取": "盛經孫絡，取分間絕皮膚",
   "原文": "夏取盛經孫絡取分間絕皮膚",
   "篇名": "四時氣"
  },
  {
   "時": "秋",
   "所取": "經腧；邪在府取之合",
   "原文": "秋取經腧邪在府取之合",
   "篇名": "四時氣"
  },
  {
   "時": "冬",
   "所取": "井滎，必深以留之",
   "原文": "冬取并滎必深以留之溫瘧汗不出為五十九痏",
   "篇名": "四時氣"
  }
 ],
 "病取": [
  {
   "病": "飱泄",
   "治": "補三陰之上，補陰陵泉，久留之",
   "原文": "飱泄補三陰之上補陰陵泉皆久留之熱行乃止",
   "篇名": "四時氣"
  },
  {
   "病": "著痹不去，久寒不已",
   "治": "取三里",
   "原文": "著痹不去久寒不已卒取其三里",
   "篇名": "四時氣"
  },
  {
   "病": "嘔膽（口苦、長太息）",
   "治": "取三里，刺少陽血絡",
   "原文": "故曰嘔膽取三里以下胃氣逆則刺少陽血絡以閉膽逆",
   "篇名": "四時氣"
  },
  {
   "病": "小腹痛腫，不得小便（三焦約）",
   "治": "取太陽大絡",
   "原文": "小腹痛腫不得小便邪在三焦約取之太陽大絡",
   "篇名": "四時氣"
  }
 ],
 "校記": [
  "「冬取并滎」，「并」通「井」，指井穴與滎穴。"
 ]
}