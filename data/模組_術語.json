 "決氣六氣": [
  {
   "術語": "精",
   "定義": "岐伯曰：兩神相搏，合而成形，常先身生",
   "篇": "決氣",
   "篇序": 30
  },
  {
   "術語": "氣",
   "定義": "何謂氣？岐伯曰：上焦開發，宣五穀味，熏膚，充身，澤毛，若霧露之溉",
   "篇": "決氣",
   "篇序": 30
  },
  {
   "術語": "津",
   "定義": "何謂津？岐伯曰：腠理發泄，汗出溱溱",
   "篇": "決氣",
   "篇序": 30
  },
  {
   "術語": "液",
   "定義": "何謂液？岐伯曰：穀入氣滿，淖澤注于骨，骨屬屈伸，洩澤，補益腦髓，皮膚潤澤",
   "篇": "決氣",
   "篇序": 30
  },
  {
   "術語": "血",
   "定義": "何謂血？岐伯曰：中焦受氣取汁，變化而赤",
   "篇": "決氣",
   "篇序": 30
  },
  {
   "術語": "脉",
   "定義": "何謂脉？岐伯曰：壅遏營氣，令無所避",
   "篇": "決氣",
   "篇序": 30
  }
 ],
