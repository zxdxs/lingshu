  {
   "尺膚": "熱甚、脉盛躁",
   "主病": "病温也；其脉盛而滑者，病且出也"
  },
  {
   "尺膚": "寒、其脉小",
   "主病": "泄、少氣"
  },
  {
   "尺膚": "炬然",
   "主病": "先熱後寒者，寒熱也"
