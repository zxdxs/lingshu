 "級": [
  {
   "級": "A",
   "名": "死不治",
   "數": 12,
   "說明": "斷定死。靈樞最硬的一級。",
   "例": [
    {
     "id": "4-37-3",
     "篇": "邪氣藏府病形",
     "seq": 4,
     "文": "太甚為陰痿；微大為石水，起臍已下至小腹腄腄然，上至胃腕，死不治。"
    },
    {
     "id": "9-1-24",
     "篇": "終始",
     "seq": 9,
     "文": "脉口四盛，且大且數者，名曰溢陰，溢陰爲內關，內關不通，死不治。"
    },
    {
     "id": "13-6-7",
     "篇": "經筋",
     "seq": 13,
     "文": "此筋折紐，紐發數甚者，死不治，名曰仲秋痹也。"
    },
    {
     "id": "13-13-5",
     "篇": "經筋",
     "seq": 13,
     "文": "其成伏梁唾血膿者，死不治。"
    },
    {
     "id": "21-1-6",
     "篇": "寒熱病",
     "seq": 21,
     "文": "齒未槁，取其少陰于陰股之絡；齒已槁，死不治。"
    },
    {
     "id": "22-1-19",
     "篇": "癲狂",
     "seq": 22,
     "文": "癲疾者，疾發如狂者，死不治。"
    }
   ],
   "全部": 12
  },
  {
   "級": "F",
   "名": "帶時限的預後",
   "數": 27,
   "說明": "不是「不治」，是「多久」。靈樞常把預後寫成一個時限。",
   "例": [
    {
     "id": "9-1-91",
     "篇": "終始",
     "seq": 9,
     "文": "少陽終者，耳聾，百節盡縱，目系絕；目系絕，一日半則死矣。"
    },
    {
     "id": "10-22-1",
     "篇": "經脉",
     "seq": 10,
     "文": "五陰氣俱絕，則目系轉，轉則目運，目運者爲志先死，志先死則遠一日半死矣。"
    },
    {
     "id": "10-22-2",
     "篇": "經脉",
     "seq": 10,
     "文": "六陽氣絕，則陰與陽相離，離則腠理發泄，絕汗乃出，故旦占夕死，夕占旦死。"
    },
    {
     "id": "23-5-1",
     "篇": "熱病",
     "seq": 23,
     "文": "熱病七日八日，脉微小，病者溲血，口中乾，一日半而死；脉代者，一日死。"
    },
    {
     "id": "23-7-1",
     "篇": "熱病",
     "seq": 23,
     "文": "熱病七日八日，脉不躁，躁不散数，後三日中有汗；三日不汗，四日死。"
    },
    {
     "id": "24-16-1",
     "篇": "厥病",
     "seq": 24,
     "文": "真心痛，手足凊至節，心痛甚，旦發夕死，夕發旦死。"
    }
   ],
   "全部": 27
  },
  {
   "級": "B",
   "名": "不治",
   "數": 11,
   "說明": "說「治不了」，但不說死。排除「迷惑而不治」這類非預後用法。",
   "例": [
    {
     "id": "22-1-13",
     "篇": "癲狂",
     "seq": 22,
     "文": "嘔多沃沫，氣下泄，不治。"
    },
    {
     "id": "22-1-15",
     "篇": "癲狂",
     "seq": 22,
     "文": "嘔多沃沫，氣下泄，不治。"
    },
    {
     "id": "22-1-18",
     "篇": "癲狂",
     "seq": 22,
     "文": "嘔多沃沫，氣下泄，不治。"
    },
    {
     "id": "23-2-1",
     "篇": "熱病",
     "seq": 23,
     "文": "痱之為病也，身無痛者，四肢不收，智亂不甚，其言微知，可治；甚則不能言，不可治也。"
    },
    {
     "id": "42-1-5",
     "篇": "病傳",
     "seq": 42,
     "文": "今余已聞陰陽之要，虚實之理，傾移之過，可治之屬，願聞病之變化，淫傳絕敗而不可治者，可得聞乎？"
    },
    {
     "id": "55-6-4",
     "篇": "逆順",
     "seq": 55,
     "文": "故曰：上工治未病，不治已病，此之謂也。"
    }
   ],
   "全部": 11
  },
  {
   "級": "D",
   "名": "可令少愈，不可已",
   "數": 1,
   "說明": "最細的一級：能緩解，不能除。全書這類寫法極少。",
   "例": [
    {
     "id": "24-9-1",
     "篇": "厥病",
     "seq": 24,
     "文": "頭痛不可刺者，大痹為惡，日作者，可令少愈，不可已。"
    }
   ],
   "全部": 1
  },
  {
   "級": "C",
   "名": "不可刺",
   "數": 22,
   "說明": "操作禁忌：不是病不可治，是此刻不可動手。",
   "例": [
    {
     "id": "5-9-3",
     "篇": "根結",
     "seq": 5,
     "文": "形氣不足，病氣不足，此陰陽氣俱不足也，不可刺之，刺之則重不足，重不足則陰陽俱竭，血氣皆盡，五藏空虛，筋骨髓枯，老者絕滅，壯者不復矣。"
    },
    {
     "id": "7-5-2",
     "篇": "官鍼",
     "seq": 7,
     "文": "脉淺者勿刺，按絕其脉乃刺之，無令精出，獨出其邪氣耳。"
    },
    {
     "id": "9-1-84",
     "篇": "終始",
     "seq": 9,
     "文": "凡刺之禁：新內勿刺，新刺勿內；已醉勿刺，已刺勿醉；新怒勿刺，已刺勿怒；新勞勿刺，已刺勿勞；已飽勿刺，已刺勿飽；已饑勿刺，已刺勿饑；已渴勿刺，已刺勿渴。"
    },
    {
     "id": "23-3-2",
     "篇": "熱病",
     "seq": 23,
     "文": "身熱甚，陰陽皆靜者，勿刺也；其可刺者，急取之，不汗出則泄。"
    },
    {
     "id": "23-3-3",
     "篇": "熱病",
     "seq": 23,
     "文": "所謂勿刺者，有死徴也。"
    },
    {
     "id": "23-6-1",
     "篇": "熱病",
     "seq": 23,
     "文": "熱病已得汗出，而脉尚躁，喘且復熱，勿刺膚，喘甚者死。"
    }
   ],
   "全部": 22
  },
  {
   "級": "E",
   "名": "難已／易已",
   "數": 7,
   "說明": "不是「不可」，是「難／易」——靈樞對療效的第三種說法。",
   "例": [
    {
     "id": "49-10-5",
     "篇": "五色",
     "seq": 49,
     "文": "脉之浮沉及人迎與寸口氣小大等者，病難已。"
    },
    {
     "id": "49-10-6",
     "篇": "五色",
     "seq": 49,
     "文": "病之在藏，沉而大者易已，小爲逆；病在府，浮而大者，其病易已。"
    },
    {
     "id": "52-6-5",
     "篇": "衛氣",
     "seq": 52,
     "文": "痛可移者，易已也；積不痛，難已也。"
    },
    {
     "id": "53-7-1",
     "篇": "論痛",
     "seq": 53,
     "文": "黃帝曰：人之病，或同時而傷，或易已，或難已，其故何如？"
    },
    {
     "id": "53-8-1",
     "篇": "論痛",
     "seq": 53,
     "文": "少俞曰：同時而傷，其身多熱者易已，多寒者難已。"
    },
    {
     "id": "74-12-1",
     "篇": "論疾診尺",
     "seq": 74,
     "文": "人病，其寸口之脈與人迎之脈小大等、及其浮沉等者，病難已也。"
    }
   ],
