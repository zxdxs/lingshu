{
 "說明": {
  "來源": "篇 81〈癰疽〉",
  "條數": 15,
  "說明": "只抽部位、病名、死期；治法與形狀留在原文段裡"
 },
 "癰疽": [
  {
   "序": 1,
   "名": "猛疽",
   "部位": "嗌中",
   "死期": "半日",
   "死期句": {
    "id": "81-1-17",
    "文": "猛疽不治，化爲膿；膿不寫，塞咽，半日死。"
   },
   "段": [
    {
     "id": "81-1-16",
     "文": "岐伯曰：癰發於嗌中，名曰猛疽。"
    },
    {
     "id": "81-1-17",
     "文": "猛疽不治，化爲膿；膿不寫，塞咽，半日死。"
    },
    {
     "id": "81-1-18",
     "文": "其化爲膿者，寫則合豕膏，冷食，三日而已。"
    }
   ]
  },
  {
   "序": 2,
   "名": "天疽",
   "部位": "頸",
   "死期": "十餘日",
   "死期句": {
    "id": "81-1-20",
    "文": "其癰大以赤黒，不急治，則熱氣下入淵腋，前傷任脉，內薰肝肺，薰肝肺十餘日而死矣。"
   },
   "段": [
    {
     "id": "81-1-19",
     "文": "發於頸，名曰天疽。"
    },
    {
     "id": "81-1-20",
     "文": "其癰大以赤黒，不急治，則熱氣下入淵腋，前傷任脉，內薰肝肺，薰肝肺十餘日而死矣。"
    },
    {
     "id": "81-1-21",
     "文": "陽留大發，消腦留項，名曰腦爍。"
    },
    {
     "id": "81-1-22",
     "文": "其色不樂，項痛而如刺以鍼，煩心者，死不可治。"
    }
   ]
  },
  {
   "序": 3,
   "名": "疵癰",
   "部位": "肩及臑",
   "死期": null,
   "死期句": null,
   "段": [
    {
     "id": "81-1-23",
     "文": "發於肩及臑，名曰疵癰。"
    },
    {
     "id": "81-1-24",
     "文": "其狀赤黒，急治之，此令人汗出至足，不害五藏。"
    },
    {
     "id": "81-1-25",
     "文": "癰發四五日，逞焫之。"
    }
   ]
  },
  {
   "序": 4,
   "名": "米疽",
   "部位": "腋下赤堅者",
   "死期": null,
   "死期句": null,
   "段": [
    {
     "id": "81-1-26",
     "文": "發於腋下赤堅者，名曰米疽。"
    },
    {
     "id": "81-1-27",
     "文": "治之以砭石，欲細而長，踈砭之，塗已豕膏，六日已，勿裹之。"
    },
    {
     "id": "81-1-28",
     "文": "其癰堅而不潰者，為馬刁挾癭，急治之。"
    }
   ]
  },
  {
   "序": 5,
   "名": "井疽",
   "部位": "胸",
   "死期": "七日",
   "死期句": {
    "id": "81-1-30",
    "文": "其狀如大豆，三四日起，不早治，下入腹，不治，七日死矣。"
   },
   "段": [
    {
     "id": "81-1-29",
     "文": "發於胸，名曰井疽。"
    },
    {
     "id": "81-1-30",
     "文": "其狀如大豆，三四日起，不早治，下入腹，不治，七日死矣。"
    }
   ]
  },
  {
   "序": 6,
   "名": "甘疽",
   "部位": "膺",
   "死期": "十嵗",
   "死期句": {
    "id": "81-1-32",
    "文": "色青，其狀如穀實、□□，常苦寒熱，急治之，去其寒熱；十嵗死，死後出膿。"
   },
   "段": [
    {
     "id": "81-1-31",
     "文": "發於膺，名曰甘疽。"
    },
    {
     "id": "81-1-32",
     "文": "色青，其狀如穀實、□□，常苦寒熱，急治之，去其寒熱；十嵗死，死後出膿。"
    }
   ]
  },
  {
   "序": 7,
   "名": "敗疵",
   "部位": "脇",
   "死期": null,
   "死期句": null,
   "段": [
    {
     "id": "81-1-33",
     "文": "發於脇，名曰敗疵。"
    },
    {
     "id": "81-1-34",
     "文": "敗疵者，女子之病也。"
    },
    {
     "id": "81-1-35",
     "文": "灸之，其病大癰膿；治之，其中乃有生肉，大如赤小豆。"
    },
    {
     "id": "81-1-36",
     "文": "剉菱草根各一升，以水一斗六升煑之，竭為取三升，則强飲，厚衣，坐於釡上，令汗出至足，已。"
    }
   ]
  },
  {
   "序": 8,
   "名": "股脛疽",
   "部位": "股脛",
   "死期": "三十日",
   "死期句": {
    "id": "81-1-38",
    "文": "其狀不甚變，而癰膿摶骨，不急治，三十日死矣。"
   },
   "段": [
    {
     "id": "81-1-37",
     "文": "發於股脛，名曰股脛疽。"
    },
    {
     "id": "81-1-38",
     "文": "其狀不甚變，而癰膿摶骨，不急治，三十日死矣。"
    }
   ]
  },
  {
   "序": 9,
   "名": "鋭疽",
   "部位": "尻",
   "死期": "三十日",
   "死期句": {
    "id": "81-1-40",
    "文": "其狀赤堅大，急治之；不治，三十日死矣。"
   },
   "段": [
    {
     "id": "81-1-39",
     "文": "發於尻，名曰鋭疽。"
    },
    {
     "id": "81-1-40",
     "文": "其狀赤堅大，急治之；不治，三十日死矣。"
    }
   ]
  },
  {
   "序": 10,
   "名": "赤施",
   "部位": "股陰",
   "死期": "六十日",
   "死期句": {
    "id": "81-1-41",
    "文": "發於股陰，名曰赤施，不急治，六十日死。"
   },
   "段": [
    {
     "id": "81-1-41",
     "文": "發於股陰，名曰赤施，不急治，六十日死。"
    },
    {
     "id": "81-1-42",
     "文": "在兩股之內，不治，十日而當死。"
    }
   ]
  },
  {
   "序": 11,
   "名": "疵癰",
   "部位": "膝",
   "死期": null,
   "死期句": null,
   "段": [
    {
     "id": "81-1-43",
     "文": "發於膝，名曰疵癰。"
    },
    {
     "id": "81-1-44",
     "文": "其狀大癰，色不變，寒熱如堅，石勿石，石之者死；須其柔，乃石之者，生。"
    },
    {
     "id": "81-1-45",
     "文": "諸癰疽之發於節而相應者，不可治也。"
    },
    {
     "id": "81-1-46",
     "文": "發於陽者，百日死；發於陰者，三十日死。"
    }
   ]
  },
  {
   "序": 12,
   "名": "兔齧",
   "部位": "脛",
   "死期": null,
   "死期句": null,
   "段": [
    {
     "id": "81-1-47",
     "文": "發於脛，名曰兔齧。"
    },
    {
     "id": "81-1-48",
     "文": "其狀赤至骨，急治之，不治害人也。"
    }
   ]
  },
  {
   "序": 13,
   "名": "走緩",
   "部位": "內踝",
   "死期": null,
   "死期句": null,
   "段": [
    {
     "id": "81-1-49",
     "文": "發於內踝，名曰走緩。"
    },
    {
     "id": "81-1-50",
     "文": "其狀癰也，色不變，數石其輸而止其寒熱，不死。"
    }
   ]
  },
  {
   "序": 14,
   "名": "四淫",
   "部位": "足上下",
   "死期": "百日",
   "死期句": {
    "id": "81-1-52",
    "文": "其狀大癰，急治之，百日死。"
   },
   "段": [
    {
     "id": "81-1-51",
     "文": "發於足上下，名曰四淫。"
    },
    {
     "id": "81-1-52",
     "文": "其狀大癰，急治之，百日死。"
    }
   ]
  },
  {
   "序": 15,
   "名": "厲癰",
   "部位": "足傍",
   "死期": "百日",
   "死期句": {
    "id": "81-1-54",
    "文": "其狀不大，初如小指發，急治之，去其黒者；不消輒益，不治，百日死。"
   },
   "段": [
    {
     "id": "81-1-53",
     "文": "發於足傍，名曰厲癰。"
    },
    {
     "id": "81-1-54",
     "文": "其狀不大，初如小指發，急治之，去其黒者；不消輒益，不治，百日死。"
    },
    {
     "id": "81-1-55",
     "文": "發於足指，名脱癰。"
    },
    {
     "id": "81-1-56",
     "文": "其狀赤黒，死不治；不赤黒，不死。"
    },
    {
     "id": "81-1-57",
     "文": "不衰，急斬之，不則死矣。"
    },
    {
     "id": "81-1-58",
     "文": "黃帝曰：夫子言癰疽，何以別之？"
    },
    {
     "id": "81-1-59",
     "文": "岐伯曰：營衛稽留於經脉之中，則血泣而不行，不行則衛氣從之而不通，壅遏而不得行，故熱。"
    },
    {
     "id": "81-1-60",
     "文": "大熱不止，熱勝則肉腐，肉腐則為膿。"
    },
    {
     "id": "81-1-61",
     "文": "然不能陷，骨髓不為燋枯，五藏不為傷，故命曰癰。"
    },
    {
     "id": "81-1-62",
     "文": "黃帝曰：何謂疽？"
    },
    {
     "id": "81-1-63",
     "文": "岐伯曰：熱氣淳盛，下陷肌膚，筋髓枯，內連五藏，血氣竭，當其癰下，筋骨良肉皆無餘，故命曰疽。"
    },
    {
     "id": "81-1-64",
     "文": "疽者，上之皮夭以堅，上如牛領之皮；癰者，其皮上薄以澤。"
    },
    {
     "id": "81-1-65",
     "文": "此其候也。"
    }
   ]
  }
 ],
 "通則": {
  "id": "81-1-46",
  "文": "發於陽者，百日死；發於陰者，三十日死。"
 }
}