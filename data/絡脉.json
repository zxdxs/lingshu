{
 "說明": {
  "來源": "篇 10〈經脉〉後段",
  "模板": "名曰某穴→起止→實則…虛則…",
  "條數": 15
 },
 "絡": [
  {
   "序": 1,
   "別": "手太陰之別",
   "穴": "列缺",
   "名": {
    "id": "10-28-1",
    "文": "○手太陰之別，名曰列缺。"
   },
   "起止": {
    "id": "10-28-2",
    "文": "起于腕上分間，並太陰之經，直入掌中，散入于魚際。"
   },
   "病": {
    "id": "10-28-3",
    "文": "其病實則手鋭掌熱，虛則欠㰦，小便遺數，取之去腕半寸，別走陽明也。"
   }
  },
  {
   "序": 2,
   "別": "手少陰之別",
   "穴": "通里",
   "名": {
    "id": "10-29-1",
    "文": "○手少陰之別，名曰通里。"
   },
   "起止": {
    "id": "10-29-2",
    "文": "去腕一寸，半別而上行，循經入于心中，繫舌本，屬目系。"
   },
   "病": {
    "id": "10-29-3",
    "文": "其實則支膈，虛則不能言，取之掌後一寸，別走太陽也。"
   }
  },
  {
   "序": 3,
   "別": "手心主之別",
   "穴": "內關",
   "名": {
    "id": "10-30-1",
    "文": "手心主之別，名曰內關。"
   },
   "起止": {
    "id": "10-30-2",
    "文": "去腕二寸，出于兩筋之間，循經以上，繫于心包，絡心系。"
   },
   "病": {
    "id": "10-30-3",
    "文": "實則心痛，虛則爲頭强，取之兩筋間也。"
   }
  },
  {
   "序": 4,
   "別": "手太陽之別",
   "穴": "支正",
   "名": {
    "id": "10-31-1",
    "文": "○手太陽之別，名曰支正。"
   },
   "起止": {
    "id": "10-31-2",
    "文": "上腕五寸，內注少陰；其別者，上走肘，絡肩髃。"
   },
   "病": {
    "id": "10-31-3",
    "文": "實則節弛肘廢，虛則生肬，小者如指痂疥，取之所別也。"
   }
  },
  {
   "序": 5,
   "別": "手陽明之別",
   "穴": "偏歷",
   "名": {
    "id": "10-32-1",
    "文": "○手陽明之別，名曰偏歷。"
   },
   "起止": {
    "id": "10-32-2",
    "文": "去腕三寸，別入太陰；其別者，上循臂，乘肩髃，上曲頰偏齒；其別者，入耳，合于宗脉。"
   },
   "病": {
    "id": "10-32-3",
    "文": "實則齲聾，虛則齒寒痹隔，取之所別也。"
   }
  },
  {
   "序": 6,
   "別": "手少陽之別",
   "穴": "外關",
   "名": {
    "id": "10-33-1",
    "文": "○手少陽之別，名曰外關。"
   },
   "起止": {
    "id": "10-33-2",
    "文": "去腕二寸，外遶臂，注胸中，合心主。"
   },
   "病": {
    "id": "10-33-3",
    "文": "病實則肘攣，虛則不收，取之所別也。"
   }
  },
  {
   "序": 7,
   "別": "足太陽之別",
   "穴": "飛陽",
   "名": {
    "id": "10-34-1",
    "文": "○足太陽之別，名曰飛陽。"
   },
   "起止": {
    "id": "10-34-2",
    "文": "去踝七寸，別走少陰。"
   },
   "病": {
    "id": "10-34-3",
    "文": "實則鼽窒頭背痛，虛則□衄，取之所別也。"
   }
  },
  {
   "序": 8,
   "別": "足少陽之別",
   "穴": "光明",
   "名": {
    "id": "10-35-1",
    "文": "○足少陽之別，名曰光明。"
   },
   "起止": {
    "id": "10-35-2",
    "文": "去踝五寸，別走厥陰，下絡足跗。"
   },
   "病": {
    "id": "10-35-3",
    "文": "實則厥，虛則痿躄，坐不能起，取之所別也。"
   }
  },
  {
   "序": 9,
   "別": "足陽明之別",
   "穴": "豐隆",
   "名": {
    "id": "10-36-1",
    "文": "○足陽明之別，名曰豐隆。"
   },
   "起止": {
    "id": "10-36-2",
    "文": "去踝八寸，別走太陰；其別者，循脛骨外廉，上絡頭項，合諸經之氣，下絡喉嗌。"
   },
   "病": {
    "id": "10-36-3",
    "文": "其病氣逆則喉痹瘁瘖，實則狂巔，虛則足不收，脛枯，取之所別也。"
   }
  },
  {
   "序": 10,
   "別": "足太陰之別",
   "穴": "公孫",
   "名": {
    "id": "10-37-1",
    "文": "○足太陰之別，名曰公孫。"
   },
   "起止": {
    "id": "10-37-2",
    "文": "去本節之後一寸，別走陽明；其別者，入絡腸胃。"
   },
   "病": {
    "id": "10-37-3",
    "文": "厥氣上逆則霍亂，實則腸中切痛，虛則鼓脹，取之所別也。"
   }
  },
  {
   "序": 11,
   "別": "足少陰之別",
   "穴": "大鍾",
   "名": {
    "id": "10-38-1",
    "文": "○足少陰之別，名曰大鍾。"
   },
   "起止": {
    "id": "10-38-2",
    "文": "當踝後繞跟，別走太陽；其別者，并經上走于心包，下外貫腰脊。"
   },
   "病": {
    "id": "10-38-3",
    "文": "其病氣逆則煩悶，實則閉癃，虛則腰痛，取之所別者也。"
   }
  },
  {
   "序": 12,
   "別": "足厥陰之別",
   "穴": "蠡溝",
   "名": {
    "id": "10-39-1",
    "文": "○足厥陰之別，名曰蠡溝。"
   },
   "起止": {
    "id": "10-39-2",
    "文": "去內踝五寸，別走少陽；其別者，徑脛上睪，結于莖。"
   },
   "病": {
    "id": "10-39-3",
    "文": "其病氣逆則睪腫卒疝，實則挺長，虛則暴癢，取之所別也。"
   }
  },
  {
   "序": 13,
   "別": "住脉之別",
   "穴": "尾翳",
   "名": {
    "id": "10-40-1",
    "文": "○住脉之別，名曰尾翳。"
   },
   "起止": {
    "id": "10-40-2",
    "文": "下鳩尾，散于腹。"
   },
   "病": {
    "id": "10-40-3",
    "文": "實則腹皮痛，虛則癢搔，取之所別也。"
   }
  },
  {
   "序": 14,
   "別": "督脉之別",
   "穴": "長强",
   "名": {
    "id": "10-41-1",
    "文": "○督脉之別，名曰長强。"
   },
   "起止": {
    "id": "10-41-2",
    "文": "挾膂上項，散頭上，下當肩胛左右，別走太陽，入貫膂。"
   },
   "病": {
    "id": "10-41-3",
    "文": "實則脊強，虛則頭重高摇之，挾脊之有過者，取之所別也。"
   }
  },
  {
   "序": 15,
   "別": "脾之大絡",
   "穴": "大包",
   "名": {
    "id": "10-42-1",
    "文": "○脾之大絡，名曰大包。"
   },
   "起止": {
    "id": "10-42-2",
    "文": "出淵腋下三寸，布胸脇。"
   },
   "病": {
    "id": "10-42-3",
    "文": "實則身盡痛，虛則百節盡皆縱，此脉若羅絡之血者，皆取之脾之大絡脉也。"
   }
  }
 ],
 "總結": {
  "id": "10-43-1",
  "文": "凡此十五絡者，實則必見，虛則必下，視之不見，求之上下，人經不同，絡脉異所別也。"
 }
}